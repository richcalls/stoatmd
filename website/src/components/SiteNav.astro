---
import { LOCALES, LOCALE_META, localePath, type Locale, t } from "../i18n";
import { PAPER } from "../i18n/paper";
import Icon from "./Icon.astro";
const { locale } = Astro.props as { locale: Locale };
const m = t(locale);
const p = PAPER[locale];
---

<a class="skip-link" href="#top">
  {p.skip}
</a>
<header class="nav wrap">
  <a class="brand" href={localePath(locale)} aria-label="StoatMD">
    <img src="/assets/mark.svg" width="36" height="36" alt="" />
    <span>
      Stoat<span class="md">MD</span>
    </span>
  </a>
  <nav class="nav-links" aria-label={m["a11y.primaryNav"]}>
    {p.nav.map((label, i) => (
      <a href={localePath(locale, ["#features", "#sync", "#pricing"][i]!)}>
        {label}
      </a>
    ))}
  </nav>
  <div class="nav-tools">
    <details class="language-picker" id="languagePicker">
      <summary aria-label={m["a11y.lang"]}>
        <Icon name="globe" size={17} />
        <span>{LOCALE_META[locale].label}</span>
        <Icon name="chevron" size={13} />
      </summary>
      <div class="language-options">
        <button type="button" data-lang="system">
          {m["lang.system"]}
        </button>
        {LOCALES.map((loc) => (
          <a
            href={localePath(loc)}
            data-lang={loc}
            lang={LOCALE_META[loc].htmlLang}
            hreflang={LOCALE_META[loc].htmlLang}
            aria-current={loc === locale ? "page" : undefined}
          >
            {LOCALE_META[loc].label}
            {loc === locale && <Icon name="check" size={16} />}
          </a>
        ))}
      </div>
    </details>
    <a class="nav-cta" href={localePath(locale, "#download")}>
      macOS
      <Icon name="arrow" size={15} />
    </a>
  </div>
</header>
