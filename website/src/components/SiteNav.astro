---
import { LOCALES, LOCALE_META, localePath, type Locale } from "../i18n";
import { SITE_COPY } from "../i18n/copy";
import Icon from "./Icon.astro";
import DownloadCta from "./DownloadCta.astro";

const { locale } = Astro.props as { locale: Locale };
const p = SITE_COPY[locale];
---

<a class="skip-link" href="#top">{p.a11y.skip}</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={localePath(locale)} aria-label="StoatMD">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-word">Stoat<span class="md">MD</span></span>
    </a>

    <nav class="site-nav" aria-label={p.a11y.nav}>
      <a href={localePath(locale, "#why")}>{p.nav.why}</a>
      <a href={localePath(locale, "#features")}>{p.nav.features}</a>
      <a href={localePath(locale, "#pricing")}>{p.nav.pricing}</a>
      <a href={localePath(locale, "#download")}>{p.nav.download}</a>
    </nav>

    <div class="header-tools">
      <button
        class="theme-toggle-btn"
        id="themeToggleBtn"
        type="button"
        aria-label="切换浅色/深色主题"
        title="切换浅色/深色主题"
      >
        <svg
          class="theme-icon sun-icon"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          class="theme-icon moon-icon"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <details class="picker lang-menu" id="languagePicker">
        <summary aria-label={p.a11y.lang}>
          <Icon name="globe" size={14} />
          <span class="lang-name">{LOCALE_META[locale].label}</span>
          <span class="chev"><Icon name="chevron" size={12} /></span>
        </summary>
        <div class="picker-options lang-options">
          <button type="button" data-lang="system">
            {p.footer.system}
          </button>
          {LOCALES.map((loc) => (
            <a
              href={localePath(loc)}
              data-lang={loc}
              lang={LOCALE_META[loc].htmlLang}
              hreflang={LOCALE_META[loc].htmlLang}
              aria-current={loc === locale ? "page" : undefined}
            >
              {LOCALE_META[loc].label}
              {loc === locale && <Icon name="check" size={14} />}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
