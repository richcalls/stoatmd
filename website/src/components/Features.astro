---
import type { Locale } from "../i18n";
import { SITE_COPY } from "../i18n/copy";

const { locale } = Astro.props as { locale: Locale };
const p = SITE_COPY[locale].features;
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="features-title">{p.title}</h2>
      <p class="section-lead">{p.body}</p>
    </div>

    <div class="section-body">
      <div class="features">
        {p.items.map((item) => (
          <div class="feature">
            <span class="feature-n">{item.n}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
