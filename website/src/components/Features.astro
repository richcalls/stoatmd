---
import type { Locale } from "../i18n";
import { PAPER } from "../i18n/paper";
import { DETAILS } from "../i18n/details";
import { COMPARISON } from "../i18n/comparison";
import Icon from "./Icon.astro";
const { locale } = Astro.props as { locale: Locale };
const p = PAPER[locale];
const d = DETAILS[locale];
const c = COMPARISON[locale];
---

<div class="benefits wrap">
  {p.benefits.map((benefit, i) => (
    <div>
      <Icon name={["folder", "offline", "palette", "cloud"][i]!} />
      <span>{benefit}</span>
    </div>
  ))}
</div>
<section class="sync-section wrap" id="sync" aria-labelledby="sync-title">
  <div class="sync-copy">
    <h2 id="sync-title">
      {p.sync.title.split("\n").map((line) => (
        <span>{line}</span>
      ))}
    </h2>
    <p>{p.sync.body}</p>
    <div class="providers">
      <Icon name="cloud" size={18} />
      Google Drive <span>/</span> Dropbox
    </div>
    <p class="sync-privacy">{d.privacy}</p>
  </div>
  <div class="sync-scene">
    <p class="scene-caption">{p.sync.folder}</p>
    <div class="file-stack" aria-hidden="true">
      <div class="stack-back"></div>
      <div class="stack-front">
        <span>.md</span>
        <Icon name="file" size={36} />
        <strong>{p.sync.file}</strong>
        <div class="file-lines">
          <i></i>
          <i></i>
        </div>
      </div>
    </div>
    <div class="sync-flow">
      {p.sync.flow.map((step, i) => (
        <>
          <span>
            <Icon name={["laptop", "cloud", "agent"][i]!} size={20} />
            {step}
          </span>
          {i < 2 && <Icon name="exchange" size={18} />}
        </>
      ))}
    </div>
    <p class="scene-caption">{p.sync.caption}</p>
  </div>
</section>
<section
  class="comparison-section wrap"
  id="why"
  aria-labelledby="comparison-title"
>
  <div class="comparison-intro">
    <h2 id="comparison-title">{c.title}</h2>
    <p>{c.intro}</p>
  </div>
  <div class="comparison-grid">
    {c.cards.map((card, i) => (
      <article class:list={{ "is-stoat": i === c.cards.length - 1 }}>
        <div class="comparison-heading">
          <h3>{card.name}</h3>
          <span>{card.tag}</span>
        </div>
        <p>{card.body}</p>
      </article>
    ))}
  </div>
</section>
<section class="details-section wrap" aria-labelledby="details-title">
  <h2 id="details-title">
    {d.title.match(/[^。.!]+[。.!]?/g)?.map((phrase) => (
      <span>{phrase.trim()}</span>
    ))}
  </h2>
  <div class="detail-grid">
    {d.items.map((item, i) => (
      <article>
        <span class="detail-number" aria-hidden="true">
          0{i + 1}
        </span>
        <div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      </article>
    ))}
  </div>
</section>
