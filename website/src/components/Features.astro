---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale);

const items = [
  { num: '01', title: m['feat.1.title'], body: m['feat.1.body'] },
  { num: '02', title: m['feat.2.title'], body: m['feat.2.body'] },
  { num: '03', title: m['feat.3.title'], body: m['feat.3.body'] },
  { num: '04', title: m['feat.4.title'], body: m['feat.4.body'] },
] as const;
---

<section class="sec" id="features" aria-labelledby="feat-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="feat-title">{m['feat.title']}</h2>
      <p class="sub">{m['feat.sub']}</p>
    </div>
    <div class="feat">
      {
        items.map((item) => (
          <article class="feat-item">
            <div class="feat-num" aria-hidden="true">
              {item.num}
            </div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
