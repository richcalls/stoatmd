---
import { type Locale } from "../i18n";
import { SITE_COPY } from "../i18n/copy";

const { locale } = Astro.props as { locale: Locale };
const p = SITE_COPY[locale];
---

<figure class="preview">
  <img
    src="/assets/mac-reader-outline-full-window.png"
    alt={p.a11y.preview}
    width="3124"
    height="1764"
    fetchpriority="high"
  />
</figure>
