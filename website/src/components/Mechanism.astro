---
import type { Locale } from "../i18n";
import { SITE_COPY } from "../i18n/copy";

const { locale } = Astro.props as { locale: Locale };
const p = SITE_COPY[locale].mechanism;
---

<section class="section" id="sync" aria-labelledby="sync-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="sync-title">{p.title}</h2>
      <p class="section-lead">{p.body}</p>
    </div>

    <div class="section-body">
      <div class="steps">
        {p.steps.map((step) => (
          <div class="step">
            <span class="step-n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
      <p class="section-note">{p.caption} · {p.providers}</p>
    </div>
  </div>
</section>
