---
import type { Locale } from "../i18n";
import { SITE_COPY } from "../i18n/copy";

const { locale } = Astro.props as { locale: Locale };
const p = SITE_COPY[locale].comparison;
---

<section class="section" id="why" aria-labelledby="why-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="why-title">{p.title}</h2>
      <p class="section-lead">{p.body}</p>
    </div>

    <div class="section-body">
      <div class="compare">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col"></th>
              {p.columns.map((column) => (
                <th scope="col">{column}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {p.rows.map((row) => (
              <tr class:list={{ ours: row.ours }}>
                <th scope="row">{row.name}</th>
                {row.cells.map((cell, index) => (
                  <td data-label={p.columns[index]}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="section-note">{p.footnote}</p>
    </div>
  </div>
</section>
