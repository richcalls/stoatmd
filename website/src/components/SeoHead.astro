---
import { LOCALES, LOCALE_META, SITE_ORIGIN, absoluteUrl, type Locale, t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale);
const meta = LOCALE_META[locale];
const canonical = absoluteUrl(locale);
const ogImage = `${SITE_ORIGIN}/assets/og-default.png`;
---

<meta charset="utf-8" />
<meta name="color-scheme" content="dark" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{m['doc.title']}</title>
<meta name="description" content={m['doc.description']} />
<meta name="theme-color" content="#1C1A17" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

{
  LOCALES.map((loc) => (
    <link
      rel="alternate"
      hreflang={LOCALE_META[loc].htmlLang}
      href={absoluteUrl(loc)}
    />
  ))
}
<link rel="alternate" hreflang="x-default" href={absoluteUrl('en')} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="StoatMD" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={m['doc.title']} />
<meta property="og:description" content={m['doc.description']} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={meta.ogLocale} />
{
  LOCALES.filter((l) => l !== locale).map((loc) => (
    <meta property="og:locale:alternate" content={LOCALE_META[loc].ogLocale} />
  ))
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={m['doc.title']} />
<meta name="twitter:description" content={m['doc.description']} />
<meta name="twitter:image" content={ogImage} />

<link
  rel="preload"
  href="/fonts/instrument-sans-v4-latin_latin-ext-regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/instrument-sans-v4-latin_latin-ext-600.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
