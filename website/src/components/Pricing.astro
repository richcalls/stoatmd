---
import type { Locale } from "../i18n";
import { PAPER } from "../i18n/paper";
import { DETAILS } from "../i18n/details";
const { locale } = Astro.props as { locale: Locale };
const p = PAPER[locale];
---

<section
  class="pricing-section wrap"
  id="pricing"
  aria-labelledby="pricing-title"
>
  <h2 id="pricing-title">{p.pricing.title}</h2>
  <div class="price-row">
    <article>
      <h3>{p.pricing.local}</h3>
      <p>{p.pricing.localBody}</p>
    </article>
    <article>
      <h3>{p.pricing.sync}</h3>
      <p>{p.pricing.syncBody}</p>
      <p>{DETAILS[locale].purchase}</p>
      <p class="price-note">{p.pricing.note}</p>
    </article>
  </div>
</section>
