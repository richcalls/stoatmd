---
import { localePath, type Locale } from "../i18n";
import { SITE_COPY } from "../i18n/copy";
import Icon from "./Icon.astro";

const { locale } = Astro.props as { locale: Locale };
const p = SITE_COPY[locale].pricing;
const tiers = [p.desktop, p.mobile];
---

<section class="section" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="pricing-title">{p.title}</h2>
      <p class="section-lead">{p.body}</p>
    </div>

    <div class="section-body">
      <div class="pricing">
        <div class="tiers">
          {tiers.map((tier) => {
            const isText = !/^\$?\d/.test(tier.price);
            return (
              <div class="tier">
                <p class="tier-label">{tier.label}</p>
                <p class:list={["tier-price", { "is-text": isText }]}>
                  {tier.price}
                </p>
                <p class="tier-name">{tier.name}</p>
                <p class="tier-unit">{tier.unit}</p>
                <ul class="tier-items">
                  {tier.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>

        <div class="pricing-foot">
          <p class="pricing-note">{p.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>
