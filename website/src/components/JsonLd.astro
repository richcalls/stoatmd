---
import { LOCALE_META, SITE_ORIGIN, absoluteUrl, type Locale } from "../i18n";
import { FIELDLOG } from "../i18n/fieldlog";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = FIELDLOG[locale];

const data = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "StoatMD",
  applicationCategory: "ProductivityApplication",
  applicationSubCategory: "Markdown notebook",
  operatingSystem: "macOS, iOS",
  softwareVersion: "1.0",
  description: p.meta.description,
  url: absoluteUrl(locale),
  image: `${SITE_ORIGIN}/assets/og-${locale}.png`,
  inLanguage: LOCALE_META[locale].htmlLang,
  author: {
    "@type": "Organization",
    name: "StoatMD",
    url: SITE_ORIGIN,
  },
  publisher: {
    "@type": "Organization",
    name: "StoatMD",
    url: SITE_ORIGIN,
  },
  offers: {
    "@type": "Offer",
    name: p.pricing.desktop.name,
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    description: `${p.pricing.desktop.unit}. ${p.pricing.note}`,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
