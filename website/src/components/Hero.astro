---
import { localePath, type Locale } from "../i18n";
import { PAPER } from "../i18n/paper";
import Icon from "./Icon.astro";
const { locale } = Astro.props as { locale: Locale };
const p = PAPER[locale];
---

<section class="hero wrap" aria-labelledby="hero-title">
  <h1 id="hero-title">
    {p.hero[0]}
    <br />
    <span>{p.hero[1]}</span>
  </h1>
  <p class="lead">{p.intro}</p>
  <div class="hero-actions">
    <a class="btn btn-primary" href={localePath(locale, "#download")}>
      {p.cta[0]}
      <Icon name="down" size={17} />
    </a>
    <a class="text-link" href={localePath(locale, "#features")}>
      {p.cta[1]}
      <Icon name="arrow" size={17} />
    </a>
  </div>
  <p class="hero-note">{p.note}</p>
</section>
