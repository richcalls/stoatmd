---
import type { Locale } from "../i18n";
import { SITE_COPY } from "../i18n/copy";
import DownloadCta from "./DownloadCta.astro";

const { locale } = Astro.props as { locale: Locale };
const p = SITE_COPY[locale];

function splitTitle(title: string): [string, string] {
  const sentence = title.match(/^(.+?[.。])\s*(.+)$/);
  if (sentence) return [sentence[1]!, sentence[2]!];
  const clause = title.match(/^(.+?[、,，])\s*(.+)$/);
  if (clause) return [clause[1]!, clause[2]!];
  return [title, ""];
}

const [titleA, titleB] = splitTitle(p.hero.title);
---

<div class="hero-copy">
  <h1 class="hero-title" id="hero-title">
    {titleA}{titleB && <span class="hero-title-second">{titleB}</span>}
  </h1>

  <p class="hero-lead">{p.hero.lead}</p>

  <div class="hero-actions">
    <DownloadCta
      mac={p.hero.primary}
      soon={p.release.soon}
      ios={p.release.ios}
    />
    <span class="hero-secondary">{p.hero.secondary}</span>
  </div>

  <p class="hero-note">{p.hero.note}</p>

  <div class="notes">
    <p class="notes-label">{p.log.label}</p>
    <div class="note-list" role="group" aria-label={p.log.label}>
      {p.log.notes.map((note, index) => (
        <button
          class="note-button"
          type="button"
          data-note={index}
          aria-pressed={index === 0}
          title={note.title}
          disabled
        >
          <span class="note-date">{note.date}</span>
          <span class="note-title">{note.title}</span>
        </button>
      ))}
    </div>
  </div>
</div>
