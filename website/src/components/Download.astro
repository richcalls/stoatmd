---
import type { Locale } from "../i18n";
import { PAPER } from "../i18n/paper";
const { locale } = Astro.props as { locale: Locale };
const p = PAPER[locale];
---

<section class="release wrap" id="download" aria-labelledby="release-title">
  <div>
    <h2 id="release-title">{p.release.title}</h2>
    <p>{p.release.body}</p>
    <p>{p.release.ios}</p>
  </div>
  <div class="release-status">
    <span class="status-dot"></span>
    {p.release.soon}
    <span class="system-requirement">macOS 14+</span>
  </div>
</section>
