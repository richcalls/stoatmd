---
import type { Locale } from "../i18n";
import { SITE_COPY } from "../i18n/copy";
import Icon from "./Icon.astro";

const { locale } = Astro.props as { locale: Locale };
const p = SITE_COPY[locale];
const r = p.release;

/**
 * Public download target. The community repository is public and hosts the
 * signed macOS build in its Releases; the source repository stays private.
 * Windows and Linux builds will land in the same Releases page later.
 */
const DOWNLOAD_URL =
  "https://github.com/richcalls/stoatmd-community/releases/latest";
---

<section class="section" id="download" aria-labelledby="download-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="download-title">{r.title}</h2>
      <p class="section-lead">{r.body}</p>
    </div>

    <div class="section-body">
      <div class="download">
        <div class="download-copy">
          <a
            class="btn"
            href={DOWNLOAD_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            {r.mac}
            <Icon name="arrow" size={14} />
          </a>
          <p class="download-note">{r.macNote}</p>
          <p class="download-platforms">{r.platforms}</p>
          <p class="download-ios">{r.ios}</p>
        </div>

        <dl class="download-specs">
          <div>
            <dt>{p.pricing.desktop.label}</dt>
            <dd>{p.pricing.desktop.name}</dd>
          </div>
          <div>
            <dt>{p.pricing.desktop.unit}</dt>
            <dd>{p.pricing.desktop.price}</dd>
          </div>
          <div>
            <dt>{p.pricing.mobile.label}</dt>
            <dd>{p.pricing.mobile.price}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
