---
import { localePath, type Locale } from "../i18n";
import { FIELDLOG } from "../i18n/fieldlog";

const { locale } = Astro.props as { locale: Locale };
const p = FIELDLOG[locale];
---

<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="foot-brand" href={localePath(locale)} aria-label="StoatMD">
          <img
            src="/assets/mark-on-dark.svg"
            width="28"
            height="28"
            alt=""
          />
          <span class="brand-word">Stoat<span class="md">MD</span></span>
        </a>
        <p class="foot-line">{p.footer.line}</p>
      </div>
      <p class="foot-copy">{p.footer.copyright}</p>
    </div>

    <div class="legal">
      <details id="privacy">
        <summary>{p.footer.privacy}</summary>
        <p>{p.footer.privacyBody}</p>
      </details>
      <details id="terms">
        <summary>{p.footer.terms}</summary>
        <p>{p.footer.termsBody}</p>
      </details>
    </div>
  </div>
</footer>
