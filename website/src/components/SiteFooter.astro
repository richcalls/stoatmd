---
import { localePath, type Locale, t } from "../i18n";
import { PAPER } from "../i18n/paper";
const { locale } = Astro.props as { locale: Locale };
const m = t(locale);
const p = PAPER[locale];
---

<footer class="foot wrap">
  <div class="footer-main">
    <a class="brand" href={localePath(locale)}>
      <img src="/assets/mark.svg" width="26" height="26" alt="" />
      <span>
        Stoat<span class="md">MD</span>
      </span>
    </a>
    <span>{p.footer}</span>
    <span class="copyright">© {new Date().getUTCFullYear()} StoatMD</span>
  </div>
  <div class="legal">
    <details id="privacy">
      <summary>{m["foot.privacy"]}</summary>
      <p>{m["foot.privacy.body"]}</p>
    </details>
    <details id="terms">
      <summary>{m["foot.terms"]}</summary>
      <p>{m["foot.terms.body"]}</p>
    </details>
  </div>
</footer>
