---
import { localePath, type Locale } from "../i18n";
import { SITE_COPY } from "../i18n/copy";

const { locale } = Astro.props as { locale: Locale };
const p = SITE_COPY[locale];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href={localePath(locale)} aria-label="StoatMD">
          <img src="/assets/mark.svg" width="24" height="24" alt="" />
          <span class="brand-word">Stoat<span class="md">MD</span></span>
        </a>
        <p class="footer-line">{p.footer.line}</p>
        <p class="footer-copy">{p.footer.copyright}</p>
      </div>

      <div class="footer-right">
        <a
          class="footer-feedback"
          href="https://github.com/richcalls/stoatmd-community/issues"
          target="_blank"
          rel="noopener noreferrer"
        >
          {p.footer.feedback}
        </a>
        <div class="footer-legal">
          <details>
            <summary>{p.footer.privacy}</summary>
            <p>{p.footer.privacyBody}</p>
          </details>
          <details>
            <summary>{p.footer.terms}</summary>
            <p>{p.footer.termsBody}</p>
          </details>
        </div>
      </div>
    </div>
  </div>
</footer>
