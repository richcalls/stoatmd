# Development configuration: export these before launching nsh.
# macOS: free local state is the default. Set 0 to simulate Pro in development.
# iOS: paid app; cloud access is included, this switch applies to macOS.
# Production purchase/entitlement integration is still pending.
STOATMD_PURCHASE_REQUIRED=1

# Google Drive desktop OAuth client; enable the Drive API.
STOATMD_GOOGLE_CLIENT_ID=
STOATMD_GOOGLE_CLIENT_SECRET=

# iOS OAuth client ID (Google Console application type: iOS).
# Export before building the iOS app; public client IDs can be bundled.
# scripts/ios.py also reads public identifiers from the Mac sync.json.
# iOS callback: com.googleusercontent.apps.<client-ID-prefix>:/oauthredirect
STOATMD_GOOGLE_IOS_CLIENT_ID=

# Minimum iOS version for signed release packages (Rust, C and Info.plist).
IPHONEOS_DEPLOYMENT_TARGET=16.0
# Optional Xcode selection for release packaging; defaults to xcode-select.
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer

# Dropbox scoped app: account_info.read, files.metadata.read/write,
# files.content.read, files.content.write. iOS bundles the public key only.
# Desktop callback: http://127.0.0.1:<port>/callback
# iOS callback: db-<app-key>://oauth2redirect
STOATMD_DROPBOX_APP_KEY=
STOATMD_DROPBOX_APP_SECRET=
STOATMD_DROPBOX_REDIRECT_PORT=53682

# Optional absolute paths. Unset values use platform application data paths.
# STOATMD_CONFIG_PATH=/absolute/path/sync.json
# STOATMD_SUPPORT_DIR=/absolute/path/StoatMD
